# Copy this file to .env for local development once Phase 1 introduces the API.
# Do not add real credentials, tokens, or production URLs to this file.

NODE_ENV=development
PORT=3000

# Local PostgreSQL settings. Replace the password only in your untracked .env.
POSTGRES_DB=secure_appsec_platform
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app_user:replace-with-a-unique-local-password@localhost:5432/secure_appsec_platform

# OpenID Connect settings (planned for Phase 2).
# KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/secure-appsec-platform
# KEYCLOAK_AUDIENCE=secure-appsec-api
